#!/bin/sh
# What each wrapped Claude is actually doing: waiting on you, still working, or
# finished and not yet looked at.
#
# tmux knows a pane exists; it has no idea what the agent inside it is up to.
# Claude's hooks do, so they write it down here and everything else — the
# picker, the tmux status line, `cc-state wait` — reads one directory of
# one-line files. No screen-scraping, no polling a TUI.
#
#   cc-state hook <state>          stdin is a hook payload; wired in settings.json
#   cc-state set <sid> <state>
#   cc-state get <target>
#   cc-state seen <target>         done -> idle: "I have looked at this"
#   cc-state list
#   cc-state summary [--tmux]      one line for a status bar
#   cc-state wait <target> [state] [-t secs]
#   cc-state clear <target>
#   cc-state prune
#
# States, borrowed wholesale from herdr: working, blocked, done, idle, unknown.
#
# A target is a Claude session uuid, a tmux pane id (%7), a pane key
# (cc-foo:@1.%7), or a tmux session name.

: "${CC_WORK_CONFIG:=$HOME/.claude-work}"
state_dir=${CC_STATE_DIR:-$HOME/.claude/agent-state}
roots="$HOME/.claude $CC_WORK_CONFIG"
tab=$(printf '\t')
now() { date +%s; }

usage() {
	echo "usage: cc-state hook|set|get|seen|list|summary|wait|clear|prune ..." >&2
	exit 1
}

# Live Claude sessions, one per line: "<sid>\t<pane-key>\t<cwd>".
#
# A record outlives a claude that died without cleaning up, and the pane key it
# names gets handed to somebody else, so a record with no process behind it is
# worse than no record at all. Drop those, the way cc-sessions does.
records() {
	for root in $roots; do
		[ -d "$root/sessions" ] || continue
		jq -r 'select(.sessionId) | [.pid // 0, .sessionId, .tmux // "", .cwd // ""] | @tsv' \
			"$root"/sessions/*.json 2>/dev/null
	done |
	while IFS="$tab" read -r pid sid key cwd; do
		[ "$pid" = 0 ] || kill -0 "$pid" 2>/dev/null || continue
		printf '%s\t%s\t%s\n' "$sid" "$key" "$cwd"
	done
}

# Anything you can name a session by -> its session id.
resolve() {
	t=${1#pane:}
	case "$t" in
		'') return 1 ;;
		# A uuid is already the answer. Match on the shape rather than a
		# character class: session ids are the only five-part dashed names here.
		*-*-*-*-*) printf '%s\n' "$t"; return 0 ;;
	esac
	case "$t" in
		# A pane id, bare or as the tail of a pane key. Compare the suffix
		# exactly: ".%7" must not match a key ending in ".%17".
		*%*)
			p=".%${t##*%}"
			records | awk -F"$tab" -v p="$p" '
				length($2) >= length(p) && substr($2, length($2) - length(p) + 1) == p { print $1; exit }' ;;
		# Otherwise a tmux session name, which prefixes the pane key.
		*)
			records | awk -F"$tab" -v n="$t:" 'index($2, n) == 1 { print $1; exit }' ;;
	esac
}

resolve_or_die() {
	sid=$(resolve "$1")
	if [ -z "$sid" ]; then
		echo "cc-state: no live Claude matching '$1'" >&2
		exit 1
	fi
	printf '%s\n' "$sid"
}

read_state() { # <sid>
	cut -f1 "$state_dir/$1" 2>/dev/null
}

write_state() { # <sid> <state>
	case "$1" in ''|*/*) return 1 ;; esac
	mkdir -p "$state_dir" 2>/dev/null || return 1
	printf '%s\t%s\n' "$2" "$(now)" > "$state_dir/$1"
}

# A desktop notification for the states that mean "come back here" — but only
# when you are not already looking at the pane. Notifying about the session
# filling the screen in front of you is pure noise.
notify() { # <sid> <state>
	[ "${CC_NOTIFY:-1}" = 1 ] || return 0
	rec=$(records | awk -F"$tab" -v s="$1" '$1 == s { print; exit }')
	[ -n "$rec" ] || return 0
	rest=${rec#*"$tab"}
	key=${rest%%"$tab"*}
	dir=${rest#*"$tab"}
	pane=${key##*.}
	[ -n "$pane" ] || return 0
	# Active pane of a session somebody is attached to = you can see it.
	seen_now=$(tmux display -pt "$pane" '#{&&:#{pane_active},#{session_attached}}' 2>/dev/null)
	[ "$seen_now" = 1 ] && return 0

	title=${dir##*/}
	[ -n "$title" ] || title=claude
	case "$2" in
		blocked) msg="waiting on you" ;;
		*) msg="finished" ;;
	esac
	if command -v terminal-notifier >/dev/null 2>&1; then
		terminal-notifier -title "$title" -message "$msg" -group "cc-$1" >/dev/null 2>&1
	elif command -v osascript >/dev/null 2>&1; then
		# Quotes and backslashes would end the AppleScript string early; the
		# strings here are ours, but the directory name is not.
		safe=$(printf '%s' "$title" | tr -d '"\\')
		osascript -e "display notification \"$msg\" with title \"claude · $safe\"" >/dev/null 2>&1
	fi
	return 0
}

# Hook entry point. Hooks run on every turn of every session, so this must
# never fail loudly and never print: a UserPromptSubmit hook's stdout is
# injected straight into Claude's context.
cmd_hook() { # <state>
	want=$1
	sid=$(jq -r '.session_id // empty' 2>/dev/null)
	[ -n "$sid" ] || exit 0
	cur=$(read_state "$sid")

	case "$want" in
		ended)
			rm -f "$state_dir/$sid" 2>/dev/null
			exit 0 ;;
		blocked)
			# Notification also fires when a finished session has merely been
			# sitting idle for a minute. That is not blocked, it is done and
			# unseen — and downgrading it would lose the "you haven't looked at
			# this yet" bit. Only a notification mid-turn is a real block.
			[ "$cur" = working ] || exit 0 ;;
		done)
			# Nothing to announce when the turn ended because you were sitting
			# right there watching it.
			: ;;
	esac

	write_state "$sid" "$want"
	case "$want" in blocked|done) notify "$sid" "$want" ;; esac
	exit 0
}

cmd_summary() {
	fmt=$1
	prune_dead
	counts=$(records | while IFS="$tab" read -r sid _ _; do read_state "$sid"; done |
		awk '{ c[$0]++ } END { printf "%d %d %d", c["blocked"], c["working"], c["done"] }')
	set -- $counts
	blocked=$1 working=$2 finished=$3
	out=
	if [ "$fmt" = --tmux ]; then
		[ "$blocked" -gt 0 ] && out="$out#[fg=red]● $blocked#[default] "
		[ "$working" -gt 0 ] && out="$out#[fg=yellow]● $working#[default] "
		[ "$finished" -gt 0 ] && out="$out#[fg=blue]● $finished#[default] "
	else
		[ "$blocked" -gt 0 ] && out="$out$blocked blocked  "
		[ "$working" -gt 0 ] && out="$out$working working  "
		[ "$finished" -gt 0 ] && out="$out$finished done  "
	fi
	# Trailing space and all: tmux status-right sits against the right edge.
	printf '%s\n' "$out"
}

# A state file for a session that no longer exists would keep a stale "done"
# on the status bar forever.
prune_dead() {
	[ -d "$state_dir" ] || return 0
	live=$(records | cut -f1)
	nl='
'
	for f in "$state_dir"/*; do
		[ -f "$f" ] || continue
		sid=${f##*/}
		case "$nl$live$nl" in
			(*"$nl$sid$nl"*) continue ;;
		esac
		rm -f "$f" 2>/dev/null
	done
}

cmd_list() {
	t=$(now)
	records | while IFS="$tab" read -r sid key cwd; do
		st=$(read_state "$sid")
		[ -n "$st" ] || st=unknown
		since=$(cut -f2 "$state_dir/$sid" 2>/dev/null)
		[ -n "$since" ] || since=$t
		printf '%s\t%s\t%ss\t%s\t%s\n' "$sid" "$st" "$((t - since))" "$key" "$cwd"
	done
}

# Block until a session reaches a state. The point of this is cc-spawn: hand a
# peer session some work, then wait for it instead of watching the pane.
cmd_wait() {
	target=$1; shift
	want=done
	timeout=0
	start_grace=${CC_WAIT_GRACE:-60}
	[ $# -gt 0 ] && case $1 in -*) ;; *) want=$1; shift ;; esac
	while [ $# -gt 0 ]; do
		case $1 in
			-t|--timeout) timeout=$2; shift 2 ;;
			*) usage ;;
		esac
	done
	[ -n "$target" ] || usage

	started=$(now)
	sid=
	while :; do
		# A session spawned a moment ago has not written its record yet, so
		# resolution is part of the loop rather than a precondition.
		if [ -z "$sid" ]; then
			sid=$(resolve "$target")
			if [ -z "$sid" ]; then
				if [ "$(( $(now) - started ))" -ge "$start_grace" ]; then
					echo "cc-state: '$target' never showed up" >&2
					exit 3
				fi
				sleep 0.5
				continue
			fi
		fi

		st=$(read_state "$sid")
		[ "$st" = "$want" ] && exit 0
		# Waiting for "done" on a session that is stuck on a question would
		# never return. Say so and hand it back.
		if [ "$want" != blocked ] && [ "$st" = blocked ]; then
			echo "cc-state: $sid is blocked and needs input" >&2
			exit 2
		fi
		# The session exiting is an answer too: there is nothing left to wait for.
		if ! records | cut -f1 | grep -qx "$sid"; then
			echo "cc-state: $sid ended" >&2
			exit 3
		fi
		if [ "$timeout" != 0 ] && [ "$(( $(now) - started ))" -ge "$timeout" ]; then
			echo "cc-state: timed out waiting for $sid to be $want (now: ${st:-unknown})" >&2
			exit 1
		fi
		sleep 0.5
	done
}

case ${1-} in
	hook)    shift; cmd_hook "${1:?state}" ;;
	set)     shift; write_state "${1:?sid}" "${2:?state}" ;;
	get)     shift; st=$(read_state "$(resolve_or_die "$1")"); printf '%s\n' "${st:-unknown}" ;;
	seen)    shift
	         sid=$(resolve_or_die "$1")
	         [ "$(read_state "$sid")" = done ] && write_state "$sid" idle
	         exit 0 ;;
	list)    shift; cmd_list ;;
	summary) shift; cmd_summary "${1-}" ;;
	wait)    shift; cmd_wait "$@" ;;
	clear)   shift; rm -f "$state_dir/$(resolve_or_die "$1")" 2>/dev/null ;;
	prune)   shift; prune_dead ;;
	*)       usage ;;
esac
