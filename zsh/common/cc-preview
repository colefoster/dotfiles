#!/bin/sh
# fzf preview for the Claude session picker: the tail of the conversation, most
# recent turn first. A raw capture-pane dump was the obvious thing to show and
# the wrong one — box rules, the status line, and soft-wrap markers crowd out
# the few words that actually identify a session.

name=$1
here=$(dirname "$0")
width=${FZF_PREVIEW_COLUMNS:-80}
turns=${CC_PREVIEW_TURNS:-8}
lines=${CC_PREVIEW_LINES:-4}

if [ "$name" = __new__ ] || [ -z "$name" ]; then
	echo "Start a new Claude session here."
	exit 0
fi

dir=$(tmux display -pt "$name" '#{session_path}' 2>/dev/null)
case "$dir" in "$HOME"*) dir="~${dir#"$HOME"}" ;; esac
state=
[ "$(tmux display -pt "$name" '#{session_attached}' 2>/dev/null)" = 0 ] || state=' · open in another window'
printf '%s\n%s%s\n' "${dir:-$name}" "$name" "$state"

"$here/cc-sessions" --turns "$name" "$turns" |
while IFS='	' read -r stamp role text; do
	[ -n "$stamp" ] || continue
	when=$(date -r "$stamp" '+%-I:%M %p')
	# Your turns are the ones that identify a session, so they get the room and
	# the brighter ink; Claude's are context, trimmed to a couple of lines.
	if [ "$role" = user ]; then
		printf '\n\033[1myou\033[0m  %s\n' "$when"
		printf '%s\n' "$text" | sed 's/\*\*//g' | fold -s -w "$((width - 2))" | head -"$lines" | sed 's/^/  /'
	else
		printf '\n\033[2mclaude  %s\n' "$when"
		printf '%s\n' "$text" | sed 's/\*\*//g' | fold -s -w "$((width - 2))" | head -2 | sed 's/^/  /'
		printf '\033[0m'
	fi
done
