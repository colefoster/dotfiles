#!/bin/sh
# List resumable Claude tmux sessions for the picker in claude.zsh, and reap the
# ones nobody has touched in a while.
#
# Output is one row per line:
#
#   <session-name>\t<age-seconds>\t<display text>
#
# The first row is always the synthetic __new__ entry, so fzf's reload binding
# keeps it after a kill. Sessions for CC_CWD sort first, then by age. Ended
# sessions from other directories come last.
#
# Age is the time since your last message in that session, not tmux's
# session_activity (a detached Claude keeps emitting output) and not
# last_attached (which ignores everything typed after the attach). Finding it
# means walking from the tmux session to the transcript:
#
#   ~/.claude*/sessions/<pid>.json    .tmux -> tmux session name, .sessionId
#   ~/.claude*/projects/*/<id>.jsonl  the transcript itself
#
# Work directories use a separate config root, so both are searched.

days=${CC_PURGE_DAYS:-10}
now=$(date +%s)
cwd=${CC_CWD:-$PWD}
tab=$(printf '\t')

roots="$HOME/.claude $HOME/.claude-blockskye"

# tmux session name -> claude session id, for every live Claude that recorded one.
map=$(
	for root in $roots; do
		[ -d "$root/sessions" ] || continue
		jq -r 'select(.tmux and .sessionId) | "\(.tmux | split(":")[0])\t\(.sessionId)"' \
			"$root"/sessions/*.json 2>/dev/null
	done
)
index=$(find $roots -maxdepth 3 -path '*/projects/*' -name '*.jsonl' 2>/dev/null)

# Every session id with a live process behind it, tmux-wrapped or not, so an
# ended session is never confused with a running one.
live_ids=$(
	for root in $roots; do
		[ -d "$root/sessions" ] || continue
		jq -r '.sessionId // empty' "$root"/sessions/*.json 2>/dev/null
	done
)

# The last thing you actually typed, newest first. Tool results, sidechain
# traffic, and the harness's synthetic turns are all somebody else talking.
JQ='fromjson?
	| select(.type == "user" and (has("toolUseResult") | not) and (.isMeta != true) and (.isSidechain != true))
	| (.message.content | if type == "string" then . else ([.[] | select(.type == "text").text] | join(" ")) end) as $t
	| select($t != null)
	| select($t | test("^\\s*(<task-notification|<system-reminder|<command-|<local-command|<bash-|\\[Request interrupted)") | not)
	| ($t | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")) as $c
	| select($c != "")
	| "\(.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)\t\($c[0:160])"'

# Print "<epoch>\t<text>" for one tmux session, or nothing when it has no
# transcript. Used by the row loop below and by cc-preview.
cc_file() {
	printf '%s\n' "$index" | grep -m1 -- "/$1.jsonl"
}

cc_last_message() {
	sid=$(cc_sid "$1")
	[ -n "$sid" ] || return 1
	file=$(cc_file "$sid")
	[ -n "$file" ] || return 1
	# Most transcripts answer from the tail; only re-read the whole file when
	# the last chunk is nothing but tool traffic.
	msg=$(tail -c 262144 "$file" 2>/dev/null | tail -r | jq -Rrc "$JQ" 2>/dev/null | head -1)
	[ -n "$msg" ] || msg=$(tail -r "$file" 2>/dev/null | jq -Rrc "$JQ" 2>/dev/null | head -1)
	[ -n "$msg" ] || return 1
	printf '%s\n' "$msg"
}

if [ "$1" = --msg ]; then
	cc_last_message "$2"
	exit $?
fi

# Directory a row belongs to. A live session knows its own; an ended transcript
# records the cwd it was started in, on some line near the top.
cc_dir() {
	case "$1" in
		resume:*)
			file=$(cc_file "${1#resume:}")
			[ -n "$file" ] || return 1
			head -c 200000 "$file" 2>/dev/null |
				grep -m1 -o '"cwd":"[^"]*"' | cut -d'"' -f4
			;;
		*) tmux display -pt "$1" '#{session_path}' 2>/dev/null ;;
	esac
}

if [ "$1" = --dir ]; then
	cc_dir "$2"
	exit $?
fi

# The same filter, but keeping both sides and tagging who spoke. Used by
# cc-preview to show the tail of the conversation.
JQ_TURNS='fromjson?
	| select((.isSidechain != true) and (.isMeta != true) and (has("toolUseResult") | not))
	| select(.type == "user" or .type == "assistant")
	| (.message.content | if type == "string" then . else ([.[] | select(.type == "text").text] | join(" ")) end) as $t
	| select($t != null)
	| select($t | test("^\\s*(<task-notification|<system-reminder|<command-|<local-command|<bash-|\\[Request interrupted)") | not)
	| ($t | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")) as $c
	| select($c != "")
	| "\(.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)\t\(.type)\t\($c[0:400])"'

# A row is either a live tmux session or a "resume:<uuid>" sentinel for a
# transcript whose session has already ended.
cc_sid() {
	case "$1" in
		resume:*) printf '%s\n' "${1#resume:}" ;;
		*) printf '%s\n' "$map" | awk -F"$tab" -v n="$1" '$1 == n { print $2; exit }' ;;
	esac
}

# Print the last N turns of one session, newest first.
cc_turns() {
	sid=$(cc_sid "$1")
	[ -n "$sid" ] || return 1
	file=$(cc_file "$sid")
	[ -n "$file" ] || return 1
	tail -c 262144 "$file" 2>/dev/null | tail -r | jq -Rrc "$JQ_TURNS" 2>/dev/null | head -"${2:-8}"
}

if [ "$1" = --turns ]; then
	cc_turns "$2" "$3"
	exit $?
fi

rows=$(
	tmux ls -F "#{session_name}${tab}#{session_path}${tab}#{session_attached}${tab}#{session_last_attached}${tab}#{session_created}" 2>/dev/null |
	while IFS="$tab" read -r name path attached last created; do
		[ "${name#cc-}" != "$name" ] || continue

		# Fall back to tmux's own clock when there is no transcript to read.
		stamp=$last
		[ "$stamp" -gt 0 ] 2>/dev/null || stamp=$created
		text=

		if msg=$(cc_last_message "$name"); then
			stamp=${msg%%"$tab"*}
			text=${msg#*"$tab"}
		fi

		# Reap on the most recent sign of life, message or attach: a session you
		# opened yesterday to resume an old conversation is still in use.
		recent=$stamp
		[ "$last" -gt "$recent" ] 2>/dev/null && recent=$last
		[ "$attached" = 0 ] && kind=0 || kind=1
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$path" "$((now - stamp))" "$((now - recent))" "$kind" "$text"
	done

	# Sessions you quit out of still have their transcript, so offer the recent
	# ones here rather than making you dig out a --resume uuid. This directory
	# first, since it is usually what you just closed.
	slug=$(printf '%s' "$cwd" | sed 's/[^a-zA-Z0-9]/-/g')
	seen=
	shown=0
	for root in $roots; do
		[ -d "$root/projects/$slug" ] || continue
		for file in $(ls -t "$root/projects/$slug"/*.jsonl 2>/dev/null); do
			[ "$shown" -lt "${CC_ENDED_MAX:-10}" ] || break
			uuid=$(basename "$file" .jsonl)
			printf '%s\n' "$live_ids" | grep -qx -- "$uuid" && continue
			msg=$(cc_last_message "resume:$uuid") || continue
			stamp=${msg%%"$tab"*}
			printf '%s\t%s\t%s\t%s\t%s\t%s\n' "resume:$uuid" "$cwd" "$((now - stamp))" "$((now - stamp))" 2 "${msg#*"$tab"}"
			seen="$seen$uuid
"
			shown=$((shown + 1))
		done
	done

	# Then the newest ended transcripts from everywhere else, so a conversation
	# you closed in another project is still one keypress away. Resuming one
	# opens it in the directory it was recorded in, not this one. The candidate
	# scan is bounded because reading each transcript's last message is not free.
	other=0
	for file in $(ls -t $roots/projects/*/*.jsonl 2>/dev/null | head -"${CC_ENDED_SCAN:-80}"); do
		[ "$other" -lt "${CC_ENDED_OTHER_MAX:-10}" ] || break
		uuid=$(basename "$file" .jsonl)
		printf '%s\n' "$live_ids" | grep -qx -- "$uuid" && continue
		printf '%s\n' "$seen" | grep -qx -- "$uuid" && continue
		dir=$(cc_dir "resume:$uuid")
		[ -n "$dir" ] || continue
		# Same directory in a different case is the same directory here.
		[ "$(printf '%s' "$dir" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$cwd" | tr 'A-Z' 'a-z')" ] && continue
		msg=$(cc_last_message "resume:$uuid") || continue
		stamp=${msg%%"$tab"*}
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "resume:$uuid" "$dir" "$((now - stamp))" "$((now - stamp))" 2 "${msg#*"$tab"}"
		other=$((other + 1))
	done
)

# Reap first, so a session killed here never appears in the list below.
if [ "$days" != 0 ]; then
	cutoff=$((days * 86400))
	printf '%s\n' "$rows" | awk -F"$tab" -v c="$cutoff" '$1 != "" && $5 == 0 && $4 > c { print $1 }' |
	while read -r stale; do
		tmux kill-session -t "=$stale" 2>/dev/null
	done
	rows=$(printf '%s\n' "$rows" | awk -F"$tab" -v c="$cutoff" '$1 != "" && ($5 == 1 || $4 <= c)')
fi

case "$cwd" in
	"$HOME"*) cwd_disp="~${cwd#"$HOME"}" ;;
	*) cwd_disp="$cwd" ;;
esac
printf '__new__\t0\t+ %-24s %-6s %8s  %s\n' "$cwd_disp" '' '' 'start a new session here'

printf '%s\n' "$rows" |
awk -F"$tab" -v home="$HOME" -v cwd="$cwd" '
	function ago(a) {
		if (a < 3600)  return int(a / 60) "m ago"
		if (a < 86400) return int(a / 3600) "h ago"
		return int(a / 86400) "d ago"
	}
	$1 != "" {
		dir = $2
		if (index(dir, home) == 1) dir = "~" substr(dir, length(home) + 1)
		# Sibling sessions share a directory, so surface the -N suffix that tells
		# them apart. The 6-char hash is the last segment on a base session.
		k = split($1, part, "-")
		if (part[k] ~ /^[0-9]+$/ && length(part[k]) < 6 && length(part[k - 1]) == 6)
			dir = dir " #" part[k]
		here = (tolower($2) == tolower(cwd)) ? 0 : 1
		# Free sessions first, then the ones open elsewhere (which have to be
		# stolen), then transcripts with no session left to attach to.
		state = ($5 == 1) ? "open" : (($5 == 2) ? "ended" : "")
		row = sprintf("%s %-24s %-6s %8s  %s", (here ? " " : "*"), dir, state, ago($3), $6)
		if ($5 != 0) row = "\033[2m" row "\033[0m"
		printf "%d\t%s\t%s\t%s\n", here * 3 + $5, $3, $1, row
	}' |
sort -t"$tab" -k1,1n -k2,2n |
cut -f2,3,4 |
awk -F"$tab" '{ printf "%s\t%s\t%s\n", $2, $1, $3 }'
