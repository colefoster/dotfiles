#!/bin/sh
# List resumable Claude tmux sessions for the picker in claude.zsh, and reap the
# ones nobody has touched in a while.
#
# Output is one row per line:
#
#   <session-name>\t<age-seconds>\t<display text>
#
# The first row is always the synthetic __new__ entry, so fzf's reload binding
# keeps it after a kill. Everything after it is one chronological list, newest
# first, whatever state the session is in.
#
# Age is the time since your last message in that session, not tmux's
# session_activity (a detached Claude keeps emitting output) and not
# last_attached (which ignores everything typed after the attach). Finding it
# means walking from the tmux session to the transcript:
#
#   ~/.claude*/sessions/<pid>.json    .tmux -> tmux session name, .sessionId
#   ~/.claude*/projects/*/<id>.jsonl  the transcript itself
#
# Work directories use a separate config root, so both are searched.


# Work account dir/label — set in the gitignored local.zsh; see cc-account.
: "${CC_WORK_CONFIG:=$HOME/.claude-work}"
: "${CC_WORK_LABEL:=Work}"
days=${CC_PURGE_DAYS:-10}
now=$(date +%s)
cwd=${CC_CWD:-$PWD}
tab=$(printf '\t')
nl='
'

roots="$HOME/.claude $CC_WORK_CONFIG"

# tmux pane key -> claude session id, for every live Claude that recorded one.
# The key is the whole "<session>:@win.%pane" string Claude records, not just the
# session name: a spun-off split puts a second conversation in the same session,
# and keying on the session name collapsed the two onto one row — one resume
# opened both, and one ctrl-x killed both.
#
# Records outlive the process that wrote them, and a session name gets reused, so
# a dead record can claim a pane key that now belongs to somebody else. Drop the
# ones with no process behind them.
map=$(
	for root in $roots; do
		[ -d "$root/sessions" ] || continue
		jq -r 'select(.tmux and .sessionId) | "\(.pid // 0)\t\(.tmux)\t\(.sessionId)"' \
			"$root"/sessions/*.json 2>/dev/null
	done |
	while IFS="$tab" read -r pid key sid; do
		[ "$pid" = 0 ] || kill -0 "$pid" 2>/dev/null || continue
		printf '%s\t%s\n' "$key" "$sid"
	done
)

# How many Claude panes a tmux session holds. One means the session and the
# conversation are the same thing; more means the rows need telling apart.
cc_panes() {
	printf '%s\n' "$map" | awk -F"$tab" -v n="$1:" 'index($1, n) == 1 { c++ } END { print c + 0 }'
}
index=$(find $roots -maxdepth 3 -path '*/projects/*' -name '*.jsonl' 2>/dev/null)

# Every session id with a live process behind it, tmux-wrapped or not, so an
# ended session is never confused with a running one.
live_ids=$(
	for root in $roots; do
		[ -d "$root/sessions" ] || continue
		jq -r 'select(.sessionId) | "\(.pid // 0)\t\(.sessionId)"' \
			"$root"/sessions/*.json 2>/dev/null
	done |
	while IFS="$tab" read -r pid sid; do
		# A record outlives a claude that died without cleaning up — a crash, a
		# kill -9, a reboot. Believing it hides that transcript from the picker
		# for good: it counts as running, so no "ended" row is offered, and its
		# tmux session is long gone so there is nothing to attach either.
		# A record with no pid to check is taken at its word.
		[ "$pid" = 0 ] || kill -0 "$pid" 2>/dev/null || continue
		printf '%s\n' "$sid"
	done
)

# The last thing you actually typed, newest first. Tool results, sidechain
# traffic, and the harness's synthetic turns are all somebody else talking.
JQ='fromjson?
	| select(.type == "user" and (has("toolUseResult") | not) and (.isMeta != true) and (.isSidechain != true))
	| (.message.content | if type == "string" then . else ([.[] | select(.type == "text").text] | join(" ")) end) as $t
	| select($t != null)
	| select($t | test("^\\s*(<task-notification|<system-reminder|<command-|<local-command|<bash-|\\[Request interrupted)") | not)
	| ($t | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")) as $c
	| select($c != "")
	| "\(.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)\t\($c[0:160])"'

# Print "<epoch>\t<text>" for one tmux session, or nothing when it has no
# transcript. Used by the row loop below and by cc-preview.
cc_file() {
	printf '%s\n' "$index" | grep -m1 -- "/$1.jsonl"
}

# A row is either a live tmux session or a "resume:<uuid>" sentinel for a
# transcript whose session has already ended.
cc_sid() {
	case "$1" in
		resume:*) printf '%s\n' "${1#resume:}" ;;
		pane:*) printf '%s\n' "$map" |
			awk -F"$tab" -v k="${1#pane:}" '$1 == k { print $2; exit }' ;;
		# A bare session name still resolves, for a row that predates pane keys.
		*) printf '%s\n' "$map" |
			awk -F"$tab" -v n="$1:" 'index($1, n) == 1 { print $2; exit }' ;;
	esac
}

# Answers are cached by transcript size. A jsonl only ever grows, so an
# unchanged size means the last message is the one already found — and an
# ended transcript never changes again. Without this, half the rows in a
# session-heavy list fall through to reading a whole megabyte-sized file,
# because a long stretch of tool calls pushes the last thing you typed out of
# the tail window.
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/cc-sessions

cc_last_message() {
	sid=$(cc_sid "$1")
	[ -n "$sid" ] || return 1
	file=$(cc_file "$sid")
	[ -n "$file" ] || return 1

	size=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
	cache=$cache_dir/$sid
	if [ -n "$size" ] && [ -f "$cache" ]; then
		cached=$(cat "$cache" 2>/dev/null)
		# "<size>\t<epoch>\t<text>" — strip the size the answer was taken at.
		case "$cached" in
			"$size$tab"*) printf '%s\n' "${cached#*"$tab"}"; return 0 ;;
		esac
	fi

	# Most transcripts answer from the tail; only re-read the whole file when
	# the last chunk is nothing but tool traffic.
	msg=$(tail -c 262144 "$file" 2>/dev/null | tail -r | jq -Rrc "$JQ" 2>/dev/null | head -1)
	[ -n "$msg" ] || msg=$(tail -r "$file" 2>/dev/null | jq -Rrc "$JQ" 2>/dev/null | head -1)
	[ -n "$msg" ] || return 1
	if [ -n "$size" ] && mkdir -p "$cache_dir" 2>/dev/null; then
		printf '%s\t%s\n' "$size" "$msg" > "$cache" 2>/dev/null
	fi
	printf '%s\n' "$msg"
}

if [ "$1" = --msg ]; then
	cc_last_message "$2"
	exit $?
fi

# Directory a row belongs to. A live session knows its own; an ended transcript
# records the cwd it was started in, on some line near the top.
cc_dir() {
	case "$1" in
		resume:*)
			file=$(cc_file "${1#resume:}")
			[ -n "$file" ] || return 1
			head -c 200000 "$file" 2>/dev/null |
				grep -m1 -o '"cwd":"[^"]*"' | cut -d'"' -f4
			;;
		pane:*)
			key=${1#pane:}
			tmux display -pt "${key##*.}" '#{pane_current_path}' 2>/dev/null ;;
		*) tmux display -pt "$1" '#{session_path}' 2>/dev/null ;;
	esac
}

if [ "$1" = --dir ]; then
	cc_dir "$2"
	exit $?
fi

# The same filter, but keeping both sides and tagging who spoke. Used by
# cc-preview to show the tail of the conversation.
JQ_TURNS='fromjson?
	| select((.isSidechain != true) and (.isMeta != true) and (has("toolUseResult") | not))
	| select(.type == "user" or .type == "assistant")
	| (.message.content | if type == "string" then . else ([.[] | select(.type == "text").text] | join(" ")) end) as $t
	| select($t != null)
	| select($t | test("^\\s*(<task-notification|<system-reminder|<command-|<local-command|<bash-|\\[Request interrupted)") | not)
	| ($t | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")) as $c
	| select($c != "")
	| "\(.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)\t\(.type)\t\($c[0:400])"'

# Print the last N turns of one session, newest first.
cc_turns() {
	sid=$(cc_sid "$1")
	[ -n "$sid" ] || return 1
	file=$(cc_file "$sid")
	[ -n "$file" ] || return 1
	# Same tail-then-whole-file fallback as cc_last_message: a session that
	# ended on a long stretch of tool calls has nothing to show in the last
	# chunk, and a blank preview reads as a broken row.
	out=$(tail -c 262144 "$file" 2>/dev/null | tail -r | jq -Rrc "$JQ_TURNS" 2>/dev/null | head -"${2:-8}")
	[ -n "$out" ] || out=$(tail -r "$file" 2>/dev/null | jq -Rrc "$JQ_TURNS" 2>/dev/null | head -"${2:-8}")
	[ -n "$out" ] || return 1
	printf '%s\n' "$out"
}

if [ "$1" = --turns ]; then
	cc_turns "$2" "$3"
	exit $?
fi

rows=$(
	# Panes, not sessions: a session split by cc-spawn holds two conversations,
	# and each of them is separately resumable and separately killable.
	tmux list-panes -a -F "#{session_name}${tab}#{window_id}${tab}#{pane_id}${tab}#{pane_index}${tab}#{pane_current_path}${tab}#{session_attached}${tab}#{session_last_attached}${tab}#{session_created}" 2>/dev/null |
	while IFS="$tab" read -r name win pane idx path attached last created; do
		[ "${name#cc-}" != "$name" ] || continue

		npanes=$(cc_panes "$name")
		id="pane:$name:$win.$pane"
		mark=
		[ "$npanes" -gt 1 ] && mark=$idx
		if [ -z "$(cc_sid "$id")" ]; then
			# No Claude here — a plain shell pane. A session made entirely of
			# them still deserves one row; a stray shell beside a live Claude
			# does not.
			[ "$npanes" = 0 ] && [ "$idx" = 1 ] || continue
			id=$name
			mark=
		fi

		# Fall back to tmux's own clock when there is no transcript to read.
		stamp=$last
		[ "$stamp" -gt 0 ] 2>/dev/null || stamp=$created
		text=

		if msg=$(cc_last_message "$id"); then
			stamp=${msg%%"$tab"*}
			text=${msg#*"$tab"}
		fi

		# Reap on the most recent sign of life, message or attach: a session you
		# opened yesterday to resume an old conversation is still in use.
		recent=$stamp
		[ "$last" -gt "$recent" ] 2>/dev/null && recent=$last
		[ "$attached" = 0 ] && kind=0 || kind=1
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$path" "$((now - stamp))" "$((now - recent))" "$kind" "$text" "$mark"
	done

	# Sessions you quit out of still have their transcript, so offer the recent
	# ones here rather than making you dig out a --resume uuid. This directory
	# first, since it is usually what you just closed.
	slug=$(printf '%s' "$cwd" | sed 's/[^a-zA-Z0-9]/-/g')
	seen=
	shown=0
	# Both accounts can hold transcripts for one directory (a work dir used
	# before the split still has personal ones). Capping root by root spent the
	# whole budget on whoever came first, so a stale account's backlog hid
	# today's sessions entirely: gather both, then sort the union by mtime.
	here_scan=
	for root in $roots; do
		for f in "$root/projects/$slug"/*.jsonl; do
			[ -f "$f" ] && here_scan="$here_scan $f"
		done
	done
	[ -n "$here_scan" ] || here_scan=/nonexistent
	for file in $(ls -t $here_scan 2>/dev/null); do
		[ "$shown" -lt "${CC_ENDED_MAX:-20}" ] || break
		uuid=${file##*/}
		uuid=${uuid%.jsonl}
		# A pipe into grep per candidate is two processes; the scan runs hundreds.
		case "$nl$live_ids$nl" in (*"$nl$uuid$nl"*) continue ;; esac
		msg=$(cc_last_message "resume:$uuid") || continue
		stamp=${msg%%"$tab"*}
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "resume:$uuid" "$cwd" "$((now - stamp))" "$((now - stamp))" 2 "${msg#*"$tab"}" ''
		seen="$seen$uuid
"
		shown=$((shown + 1))
	done

	# Then the newest ended transcripts from everywhere else, so a conversation
	# you closed in another project is still one keypress away. Resuming one
	# opens it in the directory it was recorded in, not this one. The candidate
	# scan is bounded because reading each transcript's last message is not free.
	other=0
	# "$roots/projects/*/*.jsonl" word-splits into "<root1> <root2>/projects/..."
	# — the suffix binds to the last root only, so the first account's
	# transcripts never reach the scan and the bare root arrives as a directory
	# for ls to list. Expand per root, then sort the union by mtime in one go so
	# newest-first still holds across both accounts.
	scan=
	for root in $roots; do
		for f in "$root"/projects/*/*.jsonl; do
			[ -f "$f" ] && scan="$scan $f"
		done
	done
	[ -n "$scan" ] || scan=/nonexistent
	for file in $(ls -t $scan 2>/dev/null | head -"${CC_ENDED_SCAN:-400}"); do
		[ "$other" -lt "${CC_ENDED_OTHER_MAX:-12}" ] || break
		# Cheap tests first, in pure shell: reading each candidate's directory out
		# of the file costs three processes, and the scan runs hundreds deep.
		# A transcript recorded in a scratch directory is a one-shot run of some
		# harness, not a project you would reach back into — and they arrive in
		# the hundreds, crowding every real project out of the scan window. The
		# project directory encodes the cwd, so they are recognisable by name.
		# The leading "(" is not decoration: bash 3.2 counts parens inside $( ),
		# and a bare "pattern)" reads as the end of the substitution.
		slugdir=${file%/*}
		slugdir=${slugdir##*/}
		case "$slugdir" in
			(-tmp-*|-private-tmp-*|-var-folders-*|-private-var-folders-*) continue ;;
		esac
		uuid=${file##*/}
		uuid=${uuid%.jsonl}
		case "$nl$live_ids$nl" in (*"$nl$uuid$nl"*) continue ;; esac
		case "$nl$seen$nl" in (*"$nl$uuid$nl"*) continue ;; esac
		dir=$(cc_dir "resume:$uuid")
		[ -n "$dir" ] || continue
		# Same directory in a different case is the same directory here.
		[ "$(printf '%s' "$dir" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$cwd" | tr 'A-Z' 'a-z')" ] && continue
		msg=$(cc_last_message "resume:$uuid") || continue
		stamp=${msg%%"$tab"*}
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "resume:$uuid" "$dir" "$((now - stamp))" "$((now - stamp))" 2 "${msg#*"$tab"}" ''
		other=$((other + 1))
	done
)

# Reap first, so a session killed here never appears in the list below. Reaping
# is per session, not per row: killing a session because one of its panes went
# quiet would take a live sibling conversation with it, so every pane has to be
# stale before the session goes.
if [ "$days" != 0 ]; then
	cutoff=$((days * 86400))
	dead=$(printf '%s\n' "$rows" | awk -F"$tab" -v c="$cutoff" '
		$1 == "" || $1 ~ /^resume:/ { next }
		{
			s = $1; sub(/^pane:/, "", s); sub(/:.*/, "", s)
			n[s]++
			if ($5 == 0 && $4 > c) stale[s]++
		}
		END { for (s in n) if (stale[s] == n[s]) print s }')
	printf '%s\n' "$dead" | while read -r stale; do
		[ -n "$stale" ] && tmux kill-session -t "=$stale" 2>/dev/null
	done
	rows=$(printf '%s\n' "$rows" | awk -F"$tab" -v k="$dead" '
		BEGIN { n = split(k, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") gone[a[i]] = 1 }
		$1 == "" { next }
		{
			s = $1; sub(/^pane:/, "", s); sub(/:.*/, "", s)
			if (!(s in gone)) print
		}')
fi

case "$cwd" in
	"$HOME"*) cwd_disp="~${cwd#"$HOME"}" ;;
	*) cwd_disp="$cwd" ;;
esac
printf '__new__\t0\t+ %-24s %-6s %8s  %s\n' "$cwd_disp" '' '' 'start a new session here'

printf '%s\n' "$rows" |
awk -F"$tab" -v home="$HOME" -v cwd="$cwd" '
	function ago(a) {
		if (a < 3600)  return int(a / 60) "m ago"
		if (a < 86400) return int(a / 3600) "h ago"
		return int(a / 86400) "d ago"
	}
	$1 != "" {
		dir = $2
		if (index(dir, home) == 1) dir = "~" substr(dir, length(home) + 1)
		# Sibling sessions share a directory, so surface the -N suffix that tells
		# them apart. The 6-char hash is the last segment on a base session.
		name = $1; sub(/^pane:/, "", name); sub(/:.*/, "", name)
		k = split(name, part, "-")
		if (part[k] ~ /^[0-9]+$/ && length(part[k]) < 6 && length(part[k - 1]) == 6)
			dir = dir " #" part[k]
		# Two conversations in one session: say which pane, so the rows are not
		# two identical lines.
		if ($7 != "") dir = dir " p" $7
		here = (tolower($2) == tolower(cwd)) ? 0 : 1
		# One chronological list, newest first, whatever the state: what you
		# touched last is what you are most likely reaching for. State stays
		# legible in the row itself — dim for anything not free to attach,
		# and a * for this directory.
		state = ($5 == 1) ? "open" : (($5 == 2) ? "ended" : "")
		row = sprintf("%s %-24s %-6s %8s  %s", (here ? " " : "*"), dir, state, ago($3), $6)
		if ($5 != 0) row = "\033[2m" row "\033[0m"
		printf "%s\t%s\t%s\t%s\n", $3, $3, $1, row
	}' |
sort -t"$tab" -k1,1n -k2,2n |
cut -f2,3,4 |
awk -F"$tab" '{ printf "%s\t%s\t%s\n", $2, $1, $3 }'
