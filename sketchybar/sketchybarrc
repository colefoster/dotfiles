#!/usr/bin/env bash
# SketchyBar, composed from two files:
#   style   colour + geometry   (mullion/styles/<name>.sh)
#   layout  shape + contents    (mullion/layouts/<name>.sh)
# Neither touches a keybinding. Started by AeroSpace.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/env.sh"

##### Bar #####
# A transparent bar with island brackets reads as separate floating pills;
# an opaque one reads as a single slab.
bar_color="$DECK"
[ "$BAR_TRANSPARENT" = "on" ] && bar_color=0x00000000

sketchybar --bar \
  height="$BAR_HEIGHT" \
  position="$BAR_POSITION" \
  sticky=on \
  margin="$BAR_MARGIN" \
  y_offset="$BAR_YOFF" \
  corner_radius="$BAR_RADIUS" \
  padding_left="$BAR_PADDING" \
  padding_right="$BAR_PADDING" \
  color="$bar_color" \
  border_width=0 \
  blur_radius="$BAR_BLUR" \
  shadow=off \
  topmost=window

##### Defaults #####
anim=()
[ "$ANIMATE" = "on" ] && anim=(--animate sin 12)

# CHROME decides how every item is drawn, before any colour is applied:
#   chips    filled rounded backgrounds  (Deck, Dock)
#   text     nothing at all, separators do the dividing  (Console, Instrument)
#   outline  every item is its own hard-edged box  (System)
item_bg=off; item_border=0
case "$CHROME" in
  outline) item_bg=on;  item_border="${ITEM_OUTLINE:-1}" ;;
  chips)   item_bg=off; item_border=0 ;;
  text)    item_bg=off; item_border=0 ;;
esac

sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Bold:${FONT_SIZE}.0" \
  icon.color="$INK" \
  icon.padding_left=7 \
  icon.padding_right=4 \
  label.font="$FONT:Medium:${FONT_SIZE}.0" \
  label.color="$INK" \
  label.padding_left=0 \
  label.padding_right=7 \
  background.corner_radius="$ITEM_RADIUS" \
  background.height="$ITEM_HEIGHT" \
  background.color="$PANEL" \
  background.border_color="$LINE" \
  background.border_width="$item_border" \
  background.drawing="$item_bg"

##### Items #####
# Each is a function so a layout can pick which ones exist at all.
sketchybar --add event aerospace_workspace_change

add_spaces() {
  for sid in 1 2 3 4 5 6 7 8 9; do
    sketchybar --add item space.$sid "$1" \
      --subscribe space.$sid aerospace_workspace_change front_app_switched \
      --set space.$sid \
        icon="$sid" \
        icon.padding_left=8 \
        icon.padding_right=8 \
        label.drawing=off \
        label.padding_left=0 \
        label.padding_right=8 \
        background.color="$PANEL" \
        background.drawing=off \
        click_script="aerospace workspace $sid" \
        script="$PLUGIN_DIR/aerospace.sh"
  done
  sketchybar --add item space_pad "$1" --set space_pad width=6 background.drawing=off
}
add_front_app() {
  sketchybar --add item front_app "$1" \
    --subscribe front_app front_app_switched \
    --set front_app icon.drawing=off \
      label.font="$FONT:Bold:${FONT_SIZE}.0" label.color="$AMBER" \
      script="$PLUGIN_DIR/front_app.sh"
}
add_clock()   { sketchybar --add item clock "$1" --set clock update_freq=15 \
                  icon="󰥔" icon.color="$CYAN" script="$PLUGIN_DIR/clock.sh"; }
add_battery() { sketchybar --add item battery "$1" \
                  --subscribe battery power_source_change system_woke \
                  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh"; }
add_cpu() {
  if [ "$CPU_FORM" = "graph" ]; then
    # A shape tells you the trend; a number only tells you the instant.
    sketchybar --add graph cpu "$1" 42 \
      --set cpu update_freq=3 graph.color="$AMBER" graph.line_width=1.5 \
        icon.drawing=off label.drawing=off background.drawing=off \
        script="$PLUGIN_DIR/cpu.sh"
  else
    sketchybar --add item cpu "$1" --set cpu update_freq=5 \
      icon="󰘚" icon.color="$CYAN" label.color="$DIM" script="$PLUGIN_DIR/cpu.sh"
  fi
}
add_net()     { sketchybar --add item net "$1" --set net update_freq=30 \
                  script="$PLUGIN_DIR/net.sh"; }
add_claude()  { sketchybar --add item claude "$1" --set claude update_freq=60 \
                  click_script="open -a Ghostty" script="$PLUGIN_DIR/claude.sh"; }
add_rec()     { sketchybar --add item rec "$1" --set rec update_freq=15 \
                  drawing=off script="$PLUGIN_DIR/rec.sh"; }

# A rule between fields, for chrome=text where nothing is boxed.
sep_n=0
add_sep() {
  [ "$SEP_STYLE" = "pipe" ] || return 0
  sep_n=$((sep_n + 1))
  sketchybar --add item "sep.$sep_n" "$1" \
    --set "sep.$sep_n" icon="│" icon.color="$LINE" icon.padding_left=2 \
      icon.padding_right=2 label.drawing=off background.drawing=off
}

first=1
for item in $ITEMS_LEFT; do
  [ "$first" = 1 ] || add_sep left
  "add_$item" left 2>/dev/null && first=0
done
for item in $ITEMS_CENTER; do "add_$item" center 2>/dev/null; done
first=1
for item in $ITEMS_RIGHT; do
  [ "$first" = 1 ] || add_sep right
  "add_$item" right 2>/dev/null && first=0
done

##### Islands #####
# Brackets draw one rounded background behind a group of items.
if [ "$BAR_ISLANDS" = "on" ]; then
  left_items=""
  for i in $ITEMS_LEFT; do
    [ "$i" = spaces ] && left_items="$left_items space.1 space.2 space.3 space.4 space.5 space.6 space.7 space.8 space.9" \
                      || left_items="$left_items $i"
  done
  # shellcheck disable=SC2086
  sketchybar --add bracket isle_left $left_items \
    --set isle_left background.color="$DECK" background.corner_radius="$ITEM_RADIUS" \
      background.height=$((ITEM_HEIGHT + 4)) background.drawing=on
  # shellcheck disable=SC2086
  sketchybar --add bracket isle_right $ITEMS_RIGHT \
    --set isle_right background.color="$DECK" background.corner_radius="$ITEM_RADIUS" \
      background.height=$((ITEM_HEIGHT + 4)) background.drawing=on
fi

[ ${#anim[@]} -gt 0 ] && sketchybar "${anim[@]}" --update
sketchybar --update
