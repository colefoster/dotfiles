#!/usr/bin/env bash
# SketchyBar — workspaces on the left, machine on the right, notch in between.
# Every number below comes from the active style, so switching a style changes
# the bar's shape, not just its colour. Started by AeroSpace.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/env.sh"

##### Bar #####
# BAR_MARGIN > 0 lifts the bar off the screen edges so it reads as a floating
# slab rather than a strip welded to the top.
sketchybar --bar \
  height="$BAR_HEIGHT" \
  position=top \
  sticky=on \
  margin="$BAR_MARGIN" \
  y_offset="$BAR_YOFF" \
  corner_radius="$BAR_RADIUS" \
  padding_left="$BAR_PADDING" \
  padding_right="$BAR_PADDING" \
  color="$DECK" \
  border_width=0 \
  blur_radius="$BAR_BLUR" \
  shadow=off \
  topmost=window

##### Defaults every item inherits #####
sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Bold:${FONT_SIZE}.0" \
  icon.color="$INK" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.font="$FONT:Medium:${FONT_SIZE}.0" \
  label.color="$INK" \
  label.padding_left=0 \
  label.padding_right=8 \
  background.corner_radius="$ITEM_RADIUS" \
  background.height="$ITEM_HEIGHT" \
  background.drawing=off

##### AeroSpace workspaces #####
# AeroSpace emulates its own workspaces, so the native "space" item can't see
# them — it fires this custom event on every switch instead (see aerospace.toml).
sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change front_app_switched \
    --set space.$sid \
      icon="$sid" \
      icon.padding_left=9 \
      icon.padding_right=9 \
      label.drawing=off \
      background.color="$PANEL" \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh"
done

sketchybar --add item space_pad left --set space_pad width=6 background.drawing=off

##### Focused app #####
sketchybar --add item front_app left \
  --subscribe front_app front_app_switched \
  --set front_app \
    icon.drawing=off \
    label.font="$FONT:Bold:${FONT_SIZE}.0" \
    label.color="$AMBER" \
    script="$PLUGIN_DIR/front_app.sh"

##### Right side #####
sketchybar --add item clock right \
  --set clock update_freq=15 icon="󰥔" icon.color="$CYAN" \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh"

sketchybar --add item cpu right \
  --set cpu update_freq=5 icon="󰘚" icon.color="$CYAN" label.color="$DIM" \
    script="$PLUGIN_DIR/cpu.sh"

##### Go #####
sketchybar --update
