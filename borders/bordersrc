#!/usr/bin/env bash
# JankyBorders — macOS won't tell you which window has focus once every window
# is the same size. This does. Started by AeroSpace.
# Colours come from the shared palette, so the accent is defined once.
source "$HOME/.config/theme/palette.sh"

exec borders \
  active_color="$AMBER" \
  inactive_color="$LINE" \
  width="$BORDER_WIDTH" \
  hidpi=on \
  style="$BORDER_STYLE"
