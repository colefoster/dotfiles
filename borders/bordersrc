#!/usr/bin/env bash
# JankyBorders — macOS won't tell you which window has focus once every window
# is the same size. Width, shape and whether unfocused windows get a ring at
# all all come from the active style.
source "$HOME/.config/theme/palette.sh"

inactive="$LINE"
[ "$BORDER_INACTIVE" = "off" ] && inactive=0x00000000

exec borders \
  active_color="$AMBER" \
  inactive_color="$inactive" \
  width="$BORDER_WIDTH" \
  hidpi=on \
  style="$BORDER_STYLE"
